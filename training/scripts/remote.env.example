# Private. Copy to scripts/remote.env (gitignored).

# Ray client (preferred — ships a job snapshot over the tailnet)
export DGX_RAY_ADDRESS=ray://YOUR-SPARK.tailnet.ts.net:10001
export DGX_DASHBOARD_URL=http://YOUR-SPARK.tailnet.ts.net:8265

# Optional: persistent checkout on Spark (only if you want rsync, not required for Ray)
# DGX_REMOTE_USER=youruser
# DGX_WORKER_PYTHON=/path/to/venv/bin/python   # worker python with torch/transformers/peft
# REMOTE_HOST=youruser@100.x.x.x
# REMOTE_DEST=/home/youruser/foliage-hunter
