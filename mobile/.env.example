# Expo embeds EXPO_PUBLIC_* into the client bundle — keep secrets out of these.
# Copy to mobile/.env and fill in your own gateway values. Do not commit .env.

# OpenAI-compatible gateway (LiteLLM / vLLM / Ollama) serving the Gemma foliage model.
# Must be reachable FROM THE PHONE, not just this Mac. A Tailscale hostname or 100.x IP
# works when the phone is on the same tailnet (install Tailscale on the phone and connect).
# Test on the phone in Safari: <GUIDE_URL>/v1/models
# To run Metro over Tailscale too (phone on cellular): `make start-ts` from the repo root.
EXPO_PUBLIC_GUIDE_URL=
EXPO_PUBLIC_GUIDE_MODEL=gemma-foliage
EXPO_PUBLIC_GUIDE_API_KEY=
# Reserved for a server that implements /v1/voice/turn; the app does not read it yet.
EXPO_PUBLIC_ASR_MODEL=

# Optional. Defaults to GUIDE_URL when unset. Without either, device TTS is used.
# TTS voice is required by the OpenAI-compat /audio/speech path (John, Jason, Aria, Leo, Sofia).
# Speaker names depend on your TTS server's mapping; listen before trusting the label.
EXPO_PUBLIC_TTS_URL=
EXPO_PUBLIC_TTS_MODEL=magpie-tts
EXPO_PUBLIC_TTS_VOICE=Aria

# Public Hugging Face artifacts (not for the client bundle).
FOLIAGE_HF_ADAPTER=EdyVision/foliage-hunter-gemma3-12b
FOLIAGE_HF_ADAPTER_SUBPATH=adapters/colorado_v1
FOLIAGE_HF_BASE_MODEL=google/gemma-3-12b-it
FOLIAGE_HF_EXPERIMENTS=EdyVision/foliage-hunter-experiments
